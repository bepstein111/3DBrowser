# Copy this file to .env and adjust as needed. Used by docker compose.

# Port the browser UI is served on (http://localhost:HTTP_PORT).
HTTP_PORT=8080

# Host folder to expose in browser mode; it is mounted at /models in the
# container. Point MODELS_ROOT at a subfolder to expose only part of it.
# MODELS_DIR=C:/models        # Windows
# MODELS_DIR=/path/to/models  # Linux/macOS
# MODELS_ROOT=/models
